# ============================================================
# LLM Security Lab - 환경 설정
# 이 파일을 .env로 복사한 뒤 필요한 값을 수정하세요.
# ============================================================

# --- 포트 설정 (충돌 시 변경) ---
DIFY_WEB_PORT=3000
DIFY_API_PORT=5001
FAQ_CHATBOT_PORT=5050
POSTGRES_PORT=5432
REDIS_PORT=6379
WEAVIATE_PORT=8081

# --- Dify 설정 ---
DIFY_VERSION=0.15.3
SECRET_KEY=llm-security-lab-secret-key-change-me
INIT_PASSWORD=admin123

# --- PostgreSQL ---
POSTGRES_USER=dify
POSTGRES_PASSWORD=difypass123
POSTGRES_DB=dify

# --- Redis ---
REDIS_PASSWORD=redispass123

# --- Ollama (호스트에서 실행) ---
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
DEFAULT_MODEL=qwen2.5:1.5b

# --- 외부 LLM API (선택사항) ---
# OpenAI API를 사용하려면 아래 주석을 해제하고 Key를 입력하세요.
# OPENAI_API_KEY=sk-your-key-here

# --- GPU 설정 ---
# GPU를 사용하려면 start.bat에서 --profile gpu 옵션을 사용하세요.
ENABLE_GPU=false
